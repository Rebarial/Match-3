<Window x:Class="Match_3.Game"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Match_3"
        mc:Ignorable="d"
        Title="Game" Height="650" Width="550"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        >
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Background="#FF2C3E50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚡ Time: " FontSize="24" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimerText" Text="60" FontSize="24" 
                           FontWeight="Bold" Foreground="#FF3498DB" 
                           VerticalAlignment="Center" Width="50"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="★ Score: " FontSize="24" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScoreText" Text="0" FontSize="24" 
                           FontWeight="Bold" Foreground="#FFE74C3C" 
                           VerticalAlignment="Center" Width="80"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" Background="White" x:Name="GameArea">
            <StackPanel x:Name="CenterStackPanel" Orientation="Vertical" 
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label FontSize="50" x:Name="BigTimerToStart" 
                       Foreground="Black">3!</Label>
            </StackPanel>
        </Grid>
    </Grid>
</Window>